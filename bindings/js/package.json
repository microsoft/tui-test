{
  "name": "@microsoft/shell-use",
  "version": "0.0.1-beta.5",
  "description": "Node bindings for the shell_use terminal engine",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./test": {
      "types": "./dist/test/index.d.ts",
      "default": "./dist/test/index.js"
    }
  },
  "types": "./dist/index.d.ts",
  "files": [
    "dist",
    "native/index.js",
    "native/index.d.ts",
    "native/*.node",
    "README.md"
  ],
  "engines": {
    "node": ">=20"
  },
  "sideEffects": false,
  "napi": {
    "binaryName": "shell-use",
    "packageName": "@microsoft/shell-use",
    "targets": [
      "x86_64-pc-windows-msvc",
      "aarch64-pc-windows-msvc",
      "x86_64-apple-darwin",
      "aarch64-apple-darwin",
      "x86_64-unknown-linux-gnu",
      "aarch64-unknown-linux-gnu",
      "x86_64-unknown-linux-musl",
      "aarch64-unknown-linux-musl"
    ]
  },
  "scripts": {
    "build:native": "napi build --platform --esm --release --strip --output-dir native --js index.js --dts index.d.ts",
    "build:native:debug": "napi build --platform --esm --output-dir native --js index.js --dts index.d.ts",
    "build:ts": "tsc -p tsconfig.json",
    "build": "npm run build:native && npm run build:ts",
    "create:npm-dirs": "napi create-npm-dirs",
    "artifacts": "napi artifacts --output-dir artifacts --npm-dir npm",
    "clean": "node -e \"require('node:fs').rmSync('dist',{recursive:true,force:true})\"",
    "test": "npm run build && node --test \"./test/**/*.test.mjs\"",
    "test:node": "npm run build && node --test \"./test/**/*.test.mjs\"",
    "test:bun": "npm run build && bun test ./test/conformance.test.mjs && bun test ./test/integration.test.mjs && bun test ./test/options.test.mjs && bun test ./test/protocol.test.mjs && bun test ./test/helpers.test.mjs",
    "test:deno": "npm run build && deno test -A ./test",
    "test:all": "npm run test:node && npm run test:bun && npm run test:deno"
  },
  "keywords": [
    "terminal",
    "pty",
    "automation",
    "testing",
    "tui",
    "shell-use"
  ],
  "license": "MIT",
  "author": "Microsoft",
  "repository": {
    "type": "git",
    "url": "https://github.com/microsoft/shell-use"
  },
  "publishConfig": {
    "access": "public"
  },
  "dependencies": {},
  "devDependencies": {
    "@napi-rs/cli": "^3.7.4",
    "@types/node": "^20.14.0",
    "typescript": "^5.5.0"
  }
}

{
  "name": "tui-test-trace-viewer",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "node build.mjs",
    "check": "npm run typecheck && node build.mjs --check",
    "typecheck": "svelte-check --tsconfig ./tsconfig.json --fail-on-warnings",
    "dev": "node build.mjs --watch",
    "test:unit": "node --test test/model.test.mjs",
    "test": "npm run check && npm run test:unit"
  },
  "dependencies": {
    "svelte": "5.57.0"
  },
  "devDependencies": {
    "@types/node": "22.19.15",
    "esbuild": "0.28.2",
    "svelte-check": "4.7.6",
    "typescript": "5.9.3"
  }
}
